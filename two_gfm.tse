                    default_value = "60"
                    unit = "Hz"
                    min_width = False
                    group = "Ratings:1"
                    context typhoonsim {
                    }

                    context real_time {
                    }

                }

                XL_pu {
                    label = "Coupling reactance XL"
                    description = "Inverter coupling reactance. Table 1 normal range 0.05-0.25 pu. Sets the coupling inductance and the Fig. 4 limiter."
                    widget = edit
                    type = generic
                    default_value = "0.15"
                    unit = "pu"
                    min_width = False
                    group = "Ratings:1"
                    context typhoonsim {
                    }

                    context real_time {
                    }

                }

                Rc_pu {
                    label = "Coupling resistance Rc"
                    description = "Series resistance of the coupling impedance (not in Table 1; 0.03 pu = 0.06912 ohm at 480 V, 100 kVA)"
                    widget = edit
                    type = generic
                    default_value = "0.03"
                    unit = "pu"
                    min_width = False
