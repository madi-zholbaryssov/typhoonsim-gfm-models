                    description = "Table 1 example 0 pu; should be negative when representing energy storage systems (CERTS PSCAD model uses -0.9)."
                    widget = edit
                    type = generic
                    default_value = "0.0"
                    unit = "pu"
                    min_width = False
                    group = "P-f droop:3"
                    context typhoonsim {
                    }

