    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        # The Schematic API is imported as 'mdl'
        # To get the model file path, use 'mdl.get_model_file_path()'
        # To print information to the console, use info()
        
        Ts = 100e-6
        
        # REGFM_A1 controller settings (PNNL-32278, Table 1) are set on the GFM Inverter mask;
        # the set points Pref, Qref and Vref are the GFM Inverter inputs.
        
        P = 0.75
        Pref = 0.6
        mp = 0.01
        f = 60*(1 + 0.01*(Pref-P))
        info(f"{f=}")
    ENDCODE
