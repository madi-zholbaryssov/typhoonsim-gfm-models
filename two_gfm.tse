                    min_width = False
                    group = "Ratings:1"
                    context typhoonsim {
                    }

                    context real_time {
                    }

                }

                f0 {
                    label = "Rated frequency"
                    description = "Rated frequency f0 (omega0 = 2*pi*f0)"
                    widget = edit
