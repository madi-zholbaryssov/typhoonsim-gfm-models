                [
                    position = 7712, 7648
                ]

                component "core/Constant" C_VFlag {
                    execution_rate = "Ts"
                    value = "VFlag"
                }
                [
                    position = 7456, 9760
                ]

                component "core/Probe" V_pi {
                }
                [
                    position = 9040, 9184
                ]

                component "core/C function" Fig4_Lim {
                    execution_rate = "Ts_mod"
                    input_terminals = "real Va;real Vb;real Vc;real Ia;real Ib;real Ic;real Ea_ref;real Eb_ref;real Ec_ref;"
                    input_terminals_dimensions = "(1,);(1,);(1,);(1,);(1,);(1,);(1,);(1,);(1,)"
                    input_terminals_feedthrough = "True;True;True;True;True;True;True;True;True"
                    input_terminals_show_labels = "True;True;True;True;True;True;True;True;True"
                    output_fnc = "/*Begin code section*/
/* REGFM_A1 Fig. 4 fault current limiter (PNNL-32278 Sec. 3.3).
   The current is the one the droop would drive through the coupling
   impedance Zc = Rc + jXL, Eq. (7):
       I = (Edroop - V)/(Rc + jXL),  |I| = |Edroop - V|/sqrt(Rc^2 + XL^2)
   If |I| < ImaxF the droop/modulator reference passes through; otherwise
       E = V + (ImaxF/|I|)*(Edroop - V)
   which makes the predicted current exactly ImaxF.
   Using the droop-predicted current (not the measured one) keeps the
   current angle tied to the droop angle and lets the limiter release as
   soon as the fault is cleared. Evaluated in the alpha-beta frame;
   the measured currents Ia..Ic are not used.
   ImaxF, Rc_pu, XL_pu and Vbase_LL come from the GFM Inverter mask. */
const double k23 = 2.0/3.0;
const double s32 = 0.8660254037844386;
double Vbase_pk = Vbase_LL*0.816496580927726;  /* peak phase voltage base */
double Val = k23*(Va - 0.5*Vb - 0.5*Vc);
double Vbe = k23*s32*(Vb - Vc);
double dEal = k23*(Ea_ref - 0.5*Eb_ref - 0.5*Ec_ref) - Val;
double dEbe = k23*s32*(Eb_ref - Ec_ref) - Vbe;
double dEmag_pu = sqrt(dEal*dEal + dEbe*dEbe) / Vbase_pk;
double Zc_pu = sqrt(Rc_pu*Rc_pu + XL_pu*XL_pu);
double Ipred_pu = dEmag_pu / Zc_pu;

if (Ipred_pu > ImaxF) {
    double k = ImaxF / Ipred_pu;
    double Eal = Val + k*dEal;
    double Ebe = Vbe + k*dEbe;
    Ea = Eal;
    Eb = -0.5*Eal + s32*Ebe;
    Ec = -0.5*Eal - s32*Ebe;
    lim_on = 1.0;
} else {
    Ea = Ea_ref;
    Eb = Eb_ref;
    Ec = Ec_ref;
    lim_on = 0.0;
}
/*End code section*/"
                    output_terminals = "real Ea;real Eb;real Ec;real lim_on;"
                    output_terminals_dimensions = "(1,);(1,);(1,);(1,)"
                    output_terminals_feedthrough = "True;True;True;True"
                    output_terminals_show_labels = "True;True;True;True"
                    parameters = "real ImaxF;real Rc_pu;real XL_pu;real Vbase_LL;"
                }
