                ]

                component "core/PID controller" PI_V {
                    controller_type = "PI"
                    enb_anti_windup_out = "True"
                    enb_output_limit_out = "True"
                    int_init_value = "1.1075/Emax"
                    ki = "kiv/Emax"
                    kp = "kpv/Emax"
                    lower_sat_lim = "Emin/Emax"
                }
                [
